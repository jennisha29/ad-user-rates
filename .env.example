# Copy to .env and fill in. Never commit .env or the JSON key.

# Path to the service account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=/Users/YOUR_MAC_USERNAME/keys/interaction-insights.json

# Cloud project id (the id, not the display name).
GCP_PROJECT=your-project-id-here

# Dataset created by setup_bq.py.
BQ_DATASET=interaction_insights
BQ_LOCATION=US

# Replay pace for replay.py. Rows per second, and the row cap.
SPEED=60
MAX_ROWS=50000

# Optional live overlay. The parquet backup is already GA4 and is not re-sent.
# Numeric property id (Admin → Property settings). Not the G- measurement id.
GA4_PROPERTY_ID=
